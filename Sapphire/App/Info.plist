<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeExtensions</key>
			<array>
				<string>sapphiredocklayout</string>
			</array>
			<key>CFBundleTypeName</key>
			<string>Sapphire Dock Layout</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.cshariq.sapphire.docklayout</string>
			</array>
		</dict>
	</array>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.yuxi.sapphire.local</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>sapphire</string>
			</array>
		</dict>
	</array>
	<key>FIREBASE_ANALYTICS_COLLECTION_ENABLED</key>
	<false/>
	<key>FirebaseCrashlyticsCollectionEnabled</key>
	<false/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSAudioCaptureUsageDescription</key>
	<string>Sapphire listens to your music app's audio on this Mac to time lyrics word by word. The audio never leaves your Mac.</string>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Sapphire uses Bluetooth to discover and connect to your paired Android device for Continuity (clipboard, notifications, media, hotspot).</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_sapphirecont._tcp</string>
	</array>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Sapphire uses the local network to move files, images and screen content between your Mac and your paired Android device.</string>
	<key>NSScreenCaptureUsageDescription</key>
	<string>Needed for gemini live activity</string>
	<key>NSSystemExtensionPointIdentifier</key>
	<string>com.apple.developer.driverkit.transport.audio</string>
	<key>SapphireAppGroupIdentifier</key>
	<string>$(TeamIdentifierPrefix)com.yuxi.sapphire.local</string>
	<key>SapphireSubscriptionAPIKey</key>
	<string>$(SAPPHIRE_SUBSCRIPTION_API_KEY)</string>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.json</string>
			</array>
			<key>UTTypeDescription</key>
			<string>Sapphire Settings Backup</string>
			<key>UTTypeIdentifier</key>
			<string>com.cshariq.sapphire.settings-backup</string>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>sapphirebackup</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.json</string>
			</array>
			<key>UTTypeDescription</key>
			<string>Sapphire Dock Layout</string>
			<key>UTTypeIdentifier</key>
			<string>com.cshariq.sapphire.docklayout</string>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>sapphiredocklayout</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.json</string>
			</array>
			<key>UTTypeDescription</key>
			<string>Sapphire Launchpad Item</string>
			<key>UTTypeIdentifier</key>
			<string>com.cshariq.sapphire.launchpaditem</string>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>sapphirelaunchpaditem</string>
				</array>
			</dict>
		</dict>
	</array>
</dict>
</plist>

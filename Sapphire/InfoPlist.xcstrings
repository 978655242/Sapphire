{
  "sourceLanguage": "en",
  "strings": {
    "NSAppleEventsUsageDescription": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Sapphire needs access to control playback and read track information from Music and Spotify." } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "Sapphire 需要访问 Music 和 Spotify，以控制播放并读取曲目信息。" } } } },
    "NSAppleMusicUsageDescription": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Used to show upcming songs and playlists within apple music" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "用于显示 Apple Music 中即将播放的歌曲和播放列表。" } } } },
    "NSAudioCaptureUsageDescription": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Sapphire listens to your music app's audio on this Mac to time lyrics word by word. The audio never leaves your Mac." } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "Sapphire 会在这台 Mac 上分析音乐应用的音频，以逐字同步歌词。音频不会离开你的 Mac。" } } } },
    "NSBluetoothAlwaysUsageDescription": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Sapphire uses Bluetooth to discover and connect to your paired Android device for Continuity (clipboard, notifications, media, hotspot)." } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "Sapphire 使用蓝牙发现并连接已配对的 Android 设备，以实现剪贴板、通知、媒体和热点的连续互通。" } } } },
    "NSCalendarsFullAccessUsageDescription": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Sapphire needs calendar permission to show upcoming events" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "Sapphire 需要日历权限，以显示即将开始的日程。" } } } },
    "NSCalendarsUsageDescription": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Blip can learn from your calendar patterns to better understand your schedule and preferences." } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "Blip 可以学习你的日历规律，以更好地了解你的日程安排和偏好。" } } } },
    "NSCameraUsageDescription": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Sapphire uses the camera for the Mirror widget so you can see yourself in the notch." } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "Sapphire 的镜子组件需要使用摄像头，让你能在刘海区域看到自己。" } } } },
    "NSContactsUsageDescription": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Sapphire needs access to your contacts to find the correct phone number or email when sending a reply from a notification." } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "Sapphire 需要访问通讯录，以便从通知回复时找到正确的电话号码或电子邮箱。" } } } },
    "NSFocusStatusUsageDescription": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Needed to provide live focus updates" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "用于实时更新专注模式状态。" } } } },
    "NSHumanReadableCopyright": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "© 2025 Shariq Charolia. All rights reserved." } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "© 2025 Shariq Charolia。保留所有权利。" } } } },
    "NSLocalNetworkUsageDescription": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Sapphire uses the local network to move files, images and screen content between your Mac and your paired Android device." } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "Sapphire 使用本地网络，在你的 Mac 与已配对的 Android 设备之间传输文件、图片和屏幕内容。" } } } },
    "NSLocationAlwaysAndWhenInUseUsageDescription": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Needed to provide live weather updates" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "用于提供实时天气更新。" } } } },
    "NSLocationUsageDescription": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Sapphire needs this to weather" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "Sapphire 需要位置信息，以提供当地天气。" } } } },
    "NSLocationWhenInUseUsageDescription": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Blip uses your location for local weather, nearby places, and location-aware tasks." } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "Blip 使用你的位置信息，以提供当地天气、附近地点和基于位置的任务。" } } } },
    "NSMicrophoneUsageDescription": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Sapphire uses the microphone for Gemini Live voice conversations." } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "Sapphire 使用麦克风进行 Gemini Live 语音对话。" } } } },
    "NSNetworkVolumesUsageDescription": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Sapphire needs this to provide nearby share functionality" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "Sapphire 需要访问网络宗卷，以提供附近共享功能。" } } } },
    "NSRemindersFullAccessUsageDescription": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Sapphire needs this to show upcoming reminders" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "Sapphire 需要提醒事项权限，以显示即将到来的提醒。" } } } },
    "NSRemindersUsageDescription": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Needed to show reminders" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "用于显示提醒事项。" } } } },
    "NSScreenCaptureUsageDescription": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Needed for gemini live activity" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "用于 Gemini Live 实时活动中的屏幕共享。" } } } },
    "NSSystemExtensionUsageDescription": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Sapphire needs this extension to create a virtual multi-output audio device." } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "Sapphire 需要此扩展，以创建虚拟多输出音频设备。" } } } },
    "Disk Image": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Disk Image" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "磁盘映像" } } } },
    "Archive": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Archive" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "归档文件" } } } },
    "RAR Archive": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "RAR Archive" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "RAR 归档文件" } } } },
    "Sapphire Settings Backup": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Sapphire Settings Backup" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "Sapphire 设置备份" } } } },
    "Sapphire Dock Layout": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Sapphire Dock Layout" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "Sapphire 程序坞布局" } } } },
    "Sapphire Launchpad Item": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Sapphire Launchpad Item" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "Sapphire 启动台项目" } } } }
  },
  "version": "1.0"
}

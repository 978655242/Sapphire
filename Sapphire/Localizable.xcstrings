    "Sapphire lost connection to its system helper.\n\nClick “Reset Helper” to unregister Sapphire’s own background items, reinstall the helper, and relaunch. Other apps are not affected.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphire lost connection to its system helper.\n\nClick “Reset Helper” to unregister Sapphire’s own background items, reinstall the helper, and relaunch. Other apps are not affected."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphire 与其系统辅助程序的连接已断开。\n\n点击“重置辅助程序”，以注销 Sapphire 自身的后台项目、重新安装辅助程序并重新启动。其他应用不受影响。"
          }
        }
      }
    },

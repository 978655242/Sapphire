          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphire 会自动使用 Apple「时钟」的标准快捷指令名称（“Start Timer”“Start Stopwatch”等）。如果已启用 iCloud 同步，且这些「时钟」快捷指令已存在于此 Mac 上，它们会在专注期间自动运行。"
          }

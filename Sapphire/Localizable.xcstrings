          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "特权更新辅助程序未在 90 秒内响应。在首次安装结果未知时，Sapphire 不会启动第二个安装程序；请重新打开 Sapphire 并确认其版本后再重试。"
          }
        }
      }

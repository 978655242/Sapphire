        }
      }
    },
    "Keep every clipboard item Sapphire captures with no retention cap.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep every clipboard item Sapphire captures with no retention cap."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保留 Sapphire 捕获的所有剪贴板项目，不设保留数量上限。"
          }
        }
      }
    },
    "Keep installed apps current and review app-linked data before cleanup.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep installed apps current and review app-linked data before cleanup."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让已安装的应用保持最新，并在清理前检查应用关联数据。"
          }
        }
      }
    },
    "Keep live wallpapers running whenever the display is awake.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep live wallpapers running whenever the display is awake."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示器唤醒时持续播放动态壁纸。"
          }
        }
      }
    },
    "Keep only a few apps on screen; switching to another tucks the oldest one away (restored when the session ends).": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep only a few apps on screen; switching to another tucks the oldest one away (restored when the session ends)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "屏幕上仅保留少量应用；切换到其他应用时，会隐藏最久未使用的应用（专注结束后恢复）。"
          }
        }
      }
    },
    "Keep showing the current track in lock screen widgets even when playback is paused.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep showing the current track in lock screen widgets even when playback is paused."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "即使播放已暂停，也在锁屏小组件中继续显示当前曲目。"
          }
        }
      }
    },
    "Keep the music widget visible with the last track even when playback is paused or stopped": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep the music widget visible with the last track even when playback is paused or stopped"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "即使播放暂停或停止，也保持显示音乐小组件及最后播放的曲目"
          }
        }
      }
    },
    "Keep the Sapphire notch bar visible at the top of the lock screen.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep the Sapphire notch bar visible at the top of the lock screen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在锁定屏幕顶部保持显示 Sapphire 刘海栏。"
          }
        }
      }
    },
    "Keep your Mac awake while Sapphire's caffeinate mode is active, even with the lid closed.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep your Mac awake while Sapphire's caffeinate mode is active, even with the lid closed."
          }
        },

    "Press and hold secondary player buttons (Queue, Devices, Like, Shuffle, Repeat) for an alternate action. Previous / Next / Play are tap-only unless you assign a hold action below. When this is off, Previous/Next still seek while held.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press and hold secondary player buttons (Queue, Devices, Like, Shuffle, Repeat) for an alternate action. Previous / Next / Play are tap-only unless you assign a hold action below. When this is off, Previous/Next still seek while held."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "长按播放器的辅助按钮（队列、设备、喜欢、随机播放、重复播放）可执行另一项操作。上一首、下一首和播放按钮默认仅响应轻点，除非你在下方指定长按操作。关闭此功能后，长按上一首/下一首仍可快退/快进。"
          }
        }
      }
    },
    "Press F2 in Finder to start an inline rename.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press F2 in Finder to start an inline rename."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Finder 中按 F2，即可直接编辑项目名称。"
          }
        }
      }
    },
    "Press Option + Volume keys to adjust volume for the active app (excludes Spotify and Apple Music).": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press Option + Volume keys to adjust volume for the active app (excludes Spotify and Apple Music)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按 Option + 音量键可调整当前应用的音量（不包括 Spotify 和 Apple Music）。"
          }
        }
      }
    },
    "Press this shortcut from anywhere to start or pause a focus session.": {
      "extractionState": "manual",
      "localizations": {

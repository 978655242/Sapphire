    "The app is selected automatically. Related files stay unchecked whenever exclusive ownership cannot be proven.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app is selected automatically. Related files stay unchecked whenever exclusive ownership cannot be proven."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用会自动选中。如果无法确认相关文件仅归属于该应用，这些文件将保持未选中状态。"
          }
        }
      }
    },
    "The app is selected. Identifier-linked, shared, and name-based data requires review unless ownership is verified.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app is selected. Identifier-linked, shared, and name-based data requires review unless ownership is verified."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用已选中。通过标识符关联的数据、共享数据和按名称匹配的数据都需要检查，除非已确认其归属。"
          }
        }
      }
    },
    "The application changed after it was scanned. Scan it again before removing it.": {

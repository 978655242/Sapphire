    "Response: How long the animation takes (lower is faster).\nDamping: How much bounce (1.0 is no bounce).": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Response: How long the animation takes (lower is faster).\nDamping: How much bounce (1.0 is no bounce)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "响应：动画持续的时间（值越低，速度越快）。\n阻尼：回弹的幅度（1.0 表示无回弹）。"
          }
